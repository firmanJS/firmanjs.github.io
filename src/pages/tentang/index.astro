---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const title = "Tentang Firman Abdul Hakim | Jasa Pembuatan Website Profesional";
const description = "Kenali Firman Abdul Hakim — Senior Software Engineer dengan 9+ tahun pengalaman di web development, microservices, dan optimasi SEO. Siap membantu bisnis Anda go digital.";
const canonical = "https://firmanjs.github.io/tentang/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="grid md:grid-cols-3 gap-10">
      <div class="md:col-span-1">
        <img src="/assets/img/profile.jpg" alt="Firman Abdul Hakim" class="w-full rounded-xl shadow-md" />
        <div class="mt-4 space-y-2 text-sm text-gray-600">
          <p class="flex items-center gap-2"><svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg> Sukabumi, Jawa Barat</p>
          <p class="flex items-center gap-2"><svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg> 9+ Tahun Pengalaman</p>
        </div>
        <div class="mt-6 flex gap-3">
          <a href="https://www.linkedin.com/in/firman-abdul-hakim-2a818b92" target="_blank" class="text-gray-400 hover:text-gray-600" aria-label="LinkedIn"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg></a>
          <a href="https://github.com/firmanJS" target="_blank" class="text-gray-400 hover:text-gray-600" aria-label="GitHub"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>
        </div>
      </div>
      <div class="md:col-span-2">
        <h1 class="text-3xl font-bold text-gray-900">Tentang Saya</h1>
        <p class="text-primary font-medium mt-1">Senior Software Engineer | Jasa Pembuatan Website</p>

        <div class="mt-6 space-y-4 text-gray-600 leading-relaxed text-sm">
          <p>Saya <strong>Firman Abdul Hakim</strong>, seorang <strong>Senior Software Engineer</strong> dengan spesialisasi di backend engineering dan pengembangan website. Dengan pengalaman <strong>9+ tahun</strong> di industri teknologi, saya telah menangani berbagai proyek — dari aplikasi skala enterprise hingga website company profile untuk UKM.</p>

          <p>Saya memulai karir sebagai Fullstack Web Developer pada tahun 2016, dan sejak saat itu terus berkembang hingga menjadi Principal Engineer di perusahaan teknologi terkemuka. Selama perjalanan ini, saya telah menguasai berbagai teknologi: PHP (Laravel, CodeIgniter), Node.js (Express.js, Fastify, NestJS), Python (Flask, FastAPI), dan Go.</p>

          <p>Namun di luar pekerjaan utama saya sebagai software engineer, saya juga membuka <strong>jasa pembuatan website</strong> untuk membantu bisnis — terutama UKM dan startup di Indonesia — memiliki website profesional yang tidak hanya tampil bagus, tapi juga <strong>dioptimasi untuk SEO</strong> agar mudah ditemukan di Google.</p>

          <h2 class="text-xl font-bold text-gray-900 mt-8">Pengalaman Kerja</h2>

          <div class="border-l-2 border-primary/30 pl-4 space-y-6">
            <div>
              <p class="font-semibold text-gray-900">Principal Engineer (Backend) — PT. Logika Sarana Teknologi</p>
              <p class="text-xs text-gray-500">Jan 2022 – Apr 2026 (Full Remote)</p>
              <p class="mt-1">Memimpin desain arsitektur sistem, mengembangkan microservices, dan memastikan best practice engineering di tim backend.</p>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Senior Software Engineer (Backend) — Jabar Digital Service</p>
              <p class="text-xs text-gray-500">Oct 2019 – Dec 2021 (Hybrid)</p>
              <p class="mt-1">Mengembangkan dan mengoptimalkan layanan digital Pemerintah Provinsi Jawa Barat melayani jutaan pengguna.</p>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Software Engineer — PT LAPI Divusi</p>
              <p class="text-xs text-gray-500">Apr 2017 – Sep 2019</p>
              <p class="mt-1">Mengembangkan aplikasi web full-stack menggunakan PHP, Laravel, dan Oracle Database untuk klien enterprise.</p>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Fullstack Web Developer — PT Munjalindra Karya Indonesia</p>
              <p class="text-xs text-gray-500">Nov 2016 – Mar 2017</p>
              <p class="mt-1">Mengembangkan dan memelihara aplikasi web internal dan client-facing menggunakan PHP dan CodeIgniter.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-gray-900">Kenapa Memilih Saya?</h2>
      <div class="grid sm:grid-cols-3 gap-6 mt-8">
        <div class="bg-white p-6 rounded-xl border border-gray-200">
          <p class="text-3xl font-bold text-primary">9+</p>
          <p class="text-sm font-semibold mt-1">Tahun Pengalaman</p>
          <p class="text-xs text-gray-500 mt-1">Bekerja di perusahaan teknologi terkemuka</p>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-200">
          <p class="text-3xl font-bold text-primary">15+</p>
          <p class="text-sm font-semibold mt-1">Proyek Selesai</p>
          <p class="text-xs text-gray-500 mt-1">Dari company profile hingga enterprise app</p>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-200">
          <p class="text-3xl font-bold text-primary">10+</p>
          <p class="text-sm font-semibold mt-1">Teknologi Dikuasai</p>
          <p class="text-xs text-gray-500 mt-1">PHP, Node.js, Python, Go, dan lainnya</p>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton />

</BaseLayout>
