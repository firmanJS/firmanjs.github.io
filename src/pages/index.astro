---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Portfolio from "../components/Portfolio.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const title =
  "Firman Abdul Hakim - Senior Software Engineer (Backend) | Portfolio & Jasa Pembuatan Website";
const description =
  "Firman Abdul Hakim — Senior Backend Engineer dengan 9+ tahun pengalaman membangun scalable microservices, API, dan backend systems. Jasa pembuatan website profesional di Sukabumi dan seluruh Indonesia.";
const canonical = "https://firmanjs.github.io/";

const services = [
  {
    title: "Website Company Profile",
    description:
      "Website profesional untuk memperkenalkan perusahaan, produk, dan layanan Anda. Design modern, responsive, dan SEO-friendly.",
    icon: "company",
    features: [
      "Design modern & responsive",
      "SEO optimized untuk Google",
      "Halaman: Beranda, Profil, Layanan, Galeri, Kontak",
      "Admin panel untuk update konten",
      "Integrasi Google Maps & Sosial Media",
    ],
    href: "/jasa/#company-profile",
  },
  {
    title: "Toko Online",
    description:
      "Website e-commerce siap pakai dengan sistem manajemen produk, keranjang belanja, dan payment gateway.",
    icon: "shop",
    features: [
      "Manajemen produk & kategori",
      "Keranjang belanja & checkout",
      "Payment gateway (Midtrans, Xendit)",
      "Manajemen order & status",
      "Dashboard laporan penjualan",
    ],
    href: "/jasa/#toko-online",
  },
  {
    title: "Web App Custom",
    description:
      "Aplikasi web sesuai kebutuhan spesifik bisnis Anda. Dibangun dengan teknologi modern dan scalable.",
    icon: "custom",
    features: [
      "Analisis & design sesuai kebutuhan",
      "Stack: Laravel, Node.js, Python, Go",
      "Database MySQL, PostgreSQL, MongoDB",
      "API integration pihak ketiga",
      "Deploy & maintenance",
    ],
    href: "/jasa/#custom-app",
  },
  {
    title: "SEO Optimization",
    description:
      "Optimasi website agar muncul di halaman pertama Google. Meningkatkan traffic organik dan konversi bisnis.",
    icon: "seo",
    features: [
      "Audit SEO menyeluruh",
      "Optimasi on-page & technical SEO",
      "Riset keyword kompetitor",
      "Optimasi Core Web Vitals",
      "Laporan berkala",
    ],
    href: "/page-experience/",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: "Firman Abdul Hakim",
      url: canonical,
      sameAs: [
        "https://www.linkedin.com/in/firman-abdul-hakim-2a818b92",
        "https://medium.com/@firmanabdulhakim",
        "https://github.com/firmanJS",
        "https://gitlab.com/firmanJS",
        "https://www.youtube.com/channel/UCZJtIl8S_oE1W1JW0tnaiwQ",
      ],
      jobTitle: "Senior Software Engineer, Backend Specialist",
      description: description,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Sukabumi",
        addressRegion: "West Java",
        addressCountry: "ID",
      },
    },
    {
      "@type": "WebSite",
      url: canonical,
      name: "Firman Abdul Hakim - Senior Software Engineer (Backend)",
      description: description,
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${canonical}?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={schema}
>
  <section class="max-w-6xl mx-auto px-4 py-16 md:py-20">
