---
const testimonials = [
  { name: "Client A", role: "Pemilik Bisnis, Sukabumi", text: "Pelayanan sangat profesional. Website perusahaan saya jadi cepat dan muncul di halaman pertama Google untuk kata kunci yang kami targetkan. Sangat direkomendasikan!", avatar: "" },
  { name: "Client B", role: "Founder Startup, Jakarta", text: "Proses pembuatan website cepat dan hasilnya melebihi ekspektasi. Tim responsif dan paham betul kebutuhan bisnis kami.", avatar: "" },
  { name: "Client C", role: "Owner Toko Online, Bandung", text: "Sejak website dioptimasi SEO, omset naik signifikan karena banyak pelanggan baru yang menemukan toko saya dari Google.", avatar: "" },
];
---

<section class="bg-gray-50 py-16">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-gray-900">Testimonial</h2>
      <p class="text-gray-600 mt-2">Apa kata klien tentang layanan saya</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {testimonials.map(t => (
        <div class="bg-white border border-gray-200 rounded-xl p-6">
          <div class="flex items-center gap-1 text-yellow-400 mb-3">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">"{t.text}"</p>
          <div class="mt-4 pt-4 border-t border-gray-100">
            <p class="font-semibold text-sm">{t.name}</p>
            <p class="text-xs text-gray-500">{t.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
